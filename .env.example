# Variáveis usadas apenas no build (npm run build). Nenhuma é obrigatória.

# URL pública do site, sem barra no final. Gera o link canônico e a URL
# absoluta da imagem de compartilhamento (Open Graph).
SITE_URL=https://luxsmart.vercel.app

# Subdiretório de publicação. Use "/" na Vercel e "/nome-do-repositorio/"
# no GitHub Pages (o workflow em .github/workflows já define isso sozinho).
BASE_PATH=/
